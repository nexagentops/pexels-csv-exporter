{
  "name": "pexels-csv-exporter",
  "version": "0.1.0",
  "description": "Metadata-only Pexels API exporter for JSON and CSV spreadsheet review workflows.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexagentops/pexels-csv-exporter.git"
  },
  "bugs": {
    "url": "https://github.com/nexagentops/pexels-csv-exporter/issues"
  },
  "homepage": "https://github.com/nexagentops/pexels-csv-exporter#readme",
  "keywords": [
    "pexels",
    "csv",
    "metadata",
    "typescript",
    "cli"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run lint && npm test && npm run build",
    "export": "node --import tsx src/cli.ts",
    "lint": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
